# Required when running against Convex Cloud (`npx convex dev`).
# Auto-populated by `pnpm convex:dev` on first run.
# CONVEX_DEPLOYMENT=
# CONVEX_URL=
# CONVEX_SITE_URL=
# VITE_CONVEX_URL=

# ---------- OIDC issuer config (optional) ----------
# Leave unset to run the demo without auth. The public tools
# (`notes_count`) work; the auth-gated tools return 401.
#
# Set these to point at any OIDC IdP (Auth0, Authentik, Keycloak,
# Pocket-ID, custom). The host validates Bearer tokens via the IdP's
# userinfo endpoint.
#
# OIDC_ISSUER=https://your-tenant.eu.auth0.com
# OIDC_CLIENT_ID=<pre-registered client_id>
# OIDC_USERINFO_PATH=/api/oidc/userinfo   # override if IdP uses /userinfo etc.

# ---------- OAuth bridge (optional) ----------
# Set MCP_AUTH_SERVER_URL when you want browser MCP clients (claude.ai)
# to discover OAuth via THIS deployment. Use your Convex deployment's
# `.convex.site` origin (no /mcp path).
#
# MCP_AUTH_SERVER_URL=https://your-deployment.convex.site
# MCP_RESOURCE_URL=https://your-deployment.convex.site

# ---------- Local dev identity (optional, LOCAL ONLY) ----------
# Switches on two hard-coded Bearer tokens so the auth-gated tools and
# the resources are reachable with no IdP running. `<value>` maps to
# dev-user (group admin), `<value>-readonly` to dev-reader (no groups).
#
# This is a deployment env var, not a Vite one: set it with
# `pnpm local:devtoken`, not by editing this file.
#
# NEVER set it on a deployment reachable from the internet. It grants
# the admin group to anyone who knows the string.
#
# MCP_DEV_BEARER_TOKEN=local-dev-token
