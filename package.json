{
  "name": "convex-mcp-gateway-demo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Notes-app demo for convex-mcp-gateway: exposes Convex functions as MCP tools, with auth, audit, and OAuth bridge.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.1.3",
  "scripts": {
    "local:start": "node scripts/local-convex.mjs",
    "convex:codegen": "convex codegen",
    "convex:dev": "convex dev --once --typecheck-components",
    "convex:run": "convex run",
    "convex:env": "convex env",
    "local:devtoken": "convex env set MCP_DEV_BEARER_TOKEN local-dev-token",
    "test": "vitest run",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "convex": "^1.43.0",
    "convex-mcp-gateway": "^0.8.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@edge-runtime/vm": "5.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "convex-test": "^0.0.55",
    "typescript": "~7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.0.18"
  }
}
